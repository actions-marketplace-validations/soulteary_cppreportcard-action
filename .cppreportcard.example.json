{
  "mode": "full",
  "compile_commands": "build/compile_commands.json",
  "exclude": [".git", "build", "dist", "vendor", "third_party", "external", "generated"],
  "tidy_checks": "-*,clang-analyzer-*,bugprone-*",
  "format_style": "LLVM",
  "timeout_seconds": 120,
  "jobs": 2,
  "tools": {
    "clang-format": "clang-format",
    "clang-tidy": "clang-tidy",
    "cppcheck": "cppcheck"
  }
}
